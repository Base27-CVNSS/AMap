{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Position",
  "type": "object",
  "required": ["longitude", "latitude", "timestamp"],
  "properties": {
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "accuracyMeters": { "type": ["number", "null"], "minimum": 0 },
    "heading": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
    "speedMps": { "type": ["number", "null"], "minimum": 0 },
    "roadLinkId": { "type": ["string", "null"] },
    "laneId": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
